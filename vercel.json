{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @mediacion/shared build && pnpm --filter @mediacion/api build && cd mediacion-app && npx expo export --platform web --output-dir ../public",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/vencimiento/sweep", "schedule": "0 3 * * *" }
  ],
  "functions": { "api/index.js": { "maxDuration": 60 } }
}
