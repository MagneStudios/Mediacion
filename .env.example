# ============================================================
# Proyecto Mediación — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# ============================================================

# --- Supabase (local) ---
# Obtener con: pnpm supabase status
SUPABASE_URL=http://localhost:55001
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos (para scripts Python) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:55002/postgres

# --- JWT ---
JWT_SECRET=

# --- OpenRouter (Motor de IA) ---
OPENROUTER_API_KEY=

# --- DocuSign (Firma digital) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_USER_ID=
DOCUSIGN_OAUTH_BASE=account-d.docusign.com
DOCUSIGN_PRIVATE_KEY=

# --- Mercado Pago (Cobros) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Push Notifications ---
FCM_KEY=
APNS_KEY=

# --- Biometría ---
BIOMETRIA_API_KEY=

# --- Storage ---
STORAGE_BUCKET=
STORAGE_KEY=
