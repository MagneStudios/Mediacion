{
  "name": "stitch-export-audit",
  "private": true,
  "version": "1.0.0",
  "description": "Isolated, non-production script to export approved Stitch screens for the frontend redesign audit. Not part of any pnpm workspace package.",
  "type": "module",
  "main": "fetch-stitch-designs.mjs",
  "scripts": {
    "list-projects": "node --env-file=.env.local fetch-stitch-designs.mjs list-projects",
    "list-screens": "node --env-file=.env.local fetch-stitch-designs.mjs list-screens",
    "export": "node --env-file=.env.local fetch-stitch-designs.mjs export"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.3.5"
  },
  "license": "UNLICENSED"
}
