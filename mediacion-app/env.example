# Expo inlines every EXPO_PUBLIC_* value into the client bundle.
# Only publishable values belong here. Copy this file to `.env` to use it.

# Supabase project URL (Kong gateway).
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000

# Supabase ANON key. Publishable by design.
# Never put the service_role key here: it bypasses RLS for every caller, and
# config/env.ts refuses to start if it detects one.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the NestJS API (apps/api). No trailing slash needed.
EXPO_PUBLIC_API_URL=http://localhost:3000
