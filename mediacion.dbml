// ============================================================
// Proyecto Mediación — schema.dbml
// Fase 1: Modelo de Datos
// Fecha: 2026-07-20
// Fuente: docs/Mediacion_Documentacion_Tecnica_v1.0.pdf (§5)
// ============================================================
// Requiere extensión pgcrypto para gen_random_uuid()
// ============================================================

// ============================================================
// ENUMS
// ============================================================

Enum rol_usuario {
  admin
  parte
  mediador
  estudio
}

Enum metodo_caso {
  negociacion
  conciliacion
  mediacion
}

Enum estado_caso {
  nuevo
  activo
  en_negociacion
  acordado
  cerrado
  terminado
  vencido
  expirado
}

Enum estado_ronda {
  activa
  completada
}

Enum estado_propuesta {
  pendiente
  aceptada
  rechazada
}

Enum estado_acuerdo {
  borrador
  enviado_a_firma
  firmado
  con_aviso
}

Enum estado_pago {
  pendiente
  aprobado
  rechazado
}

Enum decision_propuesta {
  acepta
  rechaza
}

Enum canal_notificacion {
  email
  push
}

Enum tipo_invitacion {
  link
  codigo
  email
}

Enum estado_invitacion {
  pendiente
  aceptada
  rechazada
  expirada
}

Enum categoria_item {
  cuidado_ninos
  cronogramas
  bienes
  economico
  personalizado
}

Enum rol_en_caso {
  parte_a
  parte_b
  mediador
}

Enum tipo_tarea {
  tarea
  evento_calendario
}

Enum estado_tarea {
  pendiente
  en_progreso
  completada
}

Enum verif_biometrica {
  pendiente
  aprobada
  rechazada
}

Enum estado_suscripcion {
  activa
  cancelada
  vencida
  pendiente_pago
}

Enum estado_mediacion {
  solicitada
  aceptada
  rechazada
  activa
  finalizada
}

Enum estado_arrepentimiento {
  recibida
  en_proceso
  resuelta
  rechazada
}

// ============================================================
// TABLAS — IDENTIDAD
// ============================================================

Table usuarios {
  id uuid [pk, default: `gen_random_uuid()`]
  rol rol_usuario [not null]
  nombre text [not null]
  apellido text [not null]
  email text [unique, not null]
  documento text [unique, not null]
  telefono text
  idioma text [default: 'es', note: 'Idioma preferido (es / en)']
  verif_biometrica verif_biometrica [default: 'pendiente']
  estudio_id uuid
  activo bool [not null, default: true]
  numero_matricula text [note: 'Número de matrícula profesional (R-05)']
  matricula_url text [note: 'Ruta al adjunto de matrícula en bucket privado (R-05)']
  fecha_baja timestamptz [note: 'Cuándo se desactivó el usuario (R-06)']
  depuracion_programada_at timestamptz [note: 'Fecha de anonimización = baja + 6 meses (R-06)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Usuarios del sistema. RF-AUT. RN-12: datos sensibles con consentimiento.'
}

Table estudios {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [not null]
  plan_id uuid
  marca_config jsonb [note: 'Configuración de marca/apariencia del estudio']
  activo bool [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Estudios jurídicos. RF-EST: panel web de gestión.'
}

Table carpetas {
  id uuid [pk, default: `gen_random_uuid()`]
  estudio_id uuid [not null]
  nombre text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Carpetas de organización del panel de estudios. RF-EST.'
}

// ============================================================
// TABLAS — MONETIZACIÓN
// ============================================================

Table planes {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [unique, not null, note: 'base | simple | plus | estudio']
  limite_carpetas int [not null, note: '-1 = ilimitado']
  limite_casos int [note: 'NULL = ilimitado (R-10)']
  limite_iteraciones_ia int [not null, note: '-1 = ilimitado']
  precio numeric(10,2) [not null, note: 'Precio neto, sin impuestos (R-09)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Planes de suscripción. RN-15: precios y límites a confirmar. R-10: ABM de planes para admin.'
}

Table suscripciones {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid
  estudio_id uuid
  plan_id uuid [not null]
  estado estado_suscripcion [not null, default: 'pendiente_pago']
  fecha_inicio timestamptz
  fecha_fin timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Suscripciones. Exactly one of usuario_id / estudio_id must be non-null (validar en API).'
}

Table pagos {
  id uuid [pk, default: `gen_random_uuid()`]
  suscripcion_id uuid [not null]
  mp_payment_id text [unique, note: 'ID del pago en Mercado Pago']
  estado estado_pago [not null, default: 'pendiente']
  monto numeric(10,2) [not null]
  metodo text [note: 'Método de pago según MP']
  fecha timestamptz
  raw_webhook jsonb [note: 'Payload completo del webhook de MP para auditoría']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Pagos via Mercado Pago. §7: estado real lo define el webhook. RN-15.'
}

Table facturas {
  id uuid [pk, default: `gen_random_uuid()`]
  pago_id uuid [not null]
  numero text [note: 'Número de comprobante ARCA']
  cae text [note: 'Código de Autorización Electrónico (opcional hasta credenciales reales)']
  url_pdf text [note: 'URL del comprobante descargable']
  neto numeric(10,2) [note: 'Base imponible (precio neto del plan, R-09)']
  iva numeric(10,2) [note: 'IVA según configuracion.impuestos']
  impuestos numeric(10,2) [note: 'Otros impuestos parametrizables']
  total numeric(10,2) [note: 'neto + iva + impuestos']
  estado text [not null, default: 'pendiente', note: "'pendiente' | 'emitida' | 'fallida' — con reintentos (R-09)"]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Facturación ARCA desde el día 1 (R-09). Todo pago aprobado genera factura.'
}

// ============================================================
// TABLAS — CASOS Y VINCULACIÓN
// ============================================================

Table casos {
  id uuid [pk, default: `gen_random_uuid()`]
  creador_id uuid [not null]
  estudio_id uuid
  carpeta_id uuid
  nombre text [not null]
  descripcion text
  metodo metodo_caso [not null]
  estado estado_caso [not null, default: 'nuevo']
  ronda_actual int [not null, default: 1, note: 'Sincronizado vía trigger con tabla rondas']
  sla_tipo text [note: 'Tipo de plazo SLA']
  plazo timestamptz [note: 'Vencimiento para el semáforo']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Casos/salas. RN-07: requiere al menos 2 partes. Máquina de estados §5. R-04: nuevo/activo → expirado cuando vence la invitación.'
}

Table caso_partes {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  usuario_id uuid [not null]
  rol_en_caso rol_en_caso [not null]
  estado_invitacion estado_invitacion [not null, default: 'pendiente']
  fecha_union timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (caso_id, usuario_id) [unique]
  }

  Note: 'Relación caso-usuario. RN-07: caso activo con 2 partes. Unique (caso_id, usuario_id).'
}

Table invitaciones {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  tipo tipo_invitacion [not null]
  token text [unique, note: 'Token para invitación por link o código']
  email_destino text [note: 'Email destino para invitación por correo']
  estado estado_invitacion [not null, default: 'pendiente']
  fecha_envio timestamptz
  pago_a_cargo text [note: "'invitador' | 'invitado' — quién paga la suscripción (R-07)"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Invitaciones a contraparte. RF-CAS: link, código o correo. R-04: vencen a las 72 h (TTL configurable).'
}

// ============================================================
// TABLAS — ITEMS / POSICIONES
// ============================================================

Table items {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  parte_id uuid [not null]
  categoria categoria_item [not null]
  nombre text [not null]
  descripcion text
  valor_min text [note: 'Rango mínimo. Text para soportar numéricos y descriptivos (ej. "fines de semana")']
  valor_max text [note: 'Rango máximo. Text por la misma razón que valor_min']
  puede_ceder bool [not null, default: false]
  condiciones_cesion text [note: 'Condiciones en las que cedería. RF-NEG-003']
  privado bool [not null, default: true, note: 'RN-01: nunca visible a la contraparte']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (caso_id, parte_id) [name: 'idx_items_caso_parte', note: 'RN-01: aislamiento de posiciones']
  }

  Note: 'Posiciones privadas. RN-01: aislamiento absoluto. RN-02: rango de acuerdo. RF-NEG.'
}

// ============================================================
// TABLAS — RONDAS Y PROPUESTAS
// ============================================================

Table rondas {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  numero int [not null, note: 'Número de ronda (1, 2, 3, ...)']
  estado estado_ronda [not null, default: 'activa']
  fecha_inicio timestamptz [not null, default: `now()`]
  fecha_fin timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (caso_id, numero) [unique]
  }

  Note: 'Rondas de negociación. RN-04: cada rechazo abre una nueva. RN-05: mediador desde ronda 3.'
}

Table propuestas {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  ronda_id uuid [not null]
  contenido jsonb [not null, note: 'Punto de encuentro propuesto por la IA (sin datos crudos de cada parte)']
  fundamentacion text [note: 'Fundamento (interés superior del niño); nullable. RN-06.']
  estado estado_propuesta [not null, default: 'pendiente']
  modelo_ia text [note: 'Modelo de OpenRouter usado (conmutable). RN-16.']
  fecha timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Propuestas de IA. RN-03: une posiciones sin exponer datos privados. RF-IA.'
}

Table respuestas_propuesta {
  id uuid [pk, default: `gen_random_uuid()`]
  propuesta_id uuid [not null]
  parte_id uuid [not null]
  decision decision_propuesta [not null]
  fecha timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (propuesta_id, parte_id) [unique]
  }

  Note: 'Respuestas de cada parte. RN-04: rechazo abre nueva ronda. Unique (propuesta_id, parte_id).'
}

// ============================================================
// TABLAS — MEDIACIÓN
// ============================================================

Table mediaciones {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  mediador_id uuid [not null]
  estado estado_mediacion [not null, default: 'solicitada']
  ronda int [not null, note: 'Número de ronda en que se solicitó']
  fecha_solicitud timestamptz [not null, default: `now()`]
  fecha_aceptacion timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Mediación humana. RN-05: desde ronda 3. A confirmar: basta una parte o acuerdo de ambas.'
}

// ============================================================
// TABLAS — ACUERDOS Y POST-ACUERDO
// ============================================================

Table acuerdos {
  id uuid [pk, default: `gen_random_uuid()`]
  caso_id uuid [not null]
  contenido jsonb [not null, note: 'Contenido del acuerdo']
  documento_url text [note: 'URL del documento generado en Storage']
  docusign_envelope_id text [note: 'ID del envelope en DocuSign']
  estado estado_acuerdo [not null, default: 'borrador']
  fecha timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Acuerdos. RN-09: firma vía DocuSign; estado lo define el webhook. RF-ACU.'
}

Table firmas {
  id uuid [pk, default: `gen_random_uuid()`]
  acuerdo_id uuid [not null]
  usuario_id uuid [not null]
  docusign_status text [not null, default: 'pending', note: 'Estado de DocuSign (sent, delivered, signed, etc.)']
  fecha_firma timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Firmas DocuSign. RN-09: la validez depende de la firma y la voluntad. Ley 25.506.'
}

Table tareas {
  id uuid [pk, default: `gen_random_uuid()`]
  acuerdo_id uuid [not null]
  caso_id uuid [not null]
  tipo tipo_tarea [not null]
  descripcion text [not null]
  fecha_evento timestamptz [note: 'Fecha del evento calendario (si aplica)']
  estado estado_tarea [not null, default: 'pendiente']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Tareas/accionables post-acuerdo. RN-14. RF-POS: pueden agregarse al calendario.'
}

Table incumplimientos {
  id uuid [pk, default: `gen_random_uuid()`]
  acuerdo_id uuid [not null]
  reportante_id uuid [not null]
  descripcion text [not null]
  fecha timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Avisos de incumplimiento. RF-ACU-005.'
}

// ============================================================
// TABLAS — NOTIFICACIONES
// ============================================================

Table notificaciones {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  caso_id uuid
  canal canal_notificacion [not null]
  evento text [not null, note: 'Tipo de evento que disparó la notificación']
  estado text [not null, default: 'pendiente', note: 'pendiente | enviada | fallida']
  fecha timestamptz
  leido_at timestamptz [note: 'NULL = no leída (read receipt separado del estado de delivery)']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Notificaciones email/push. RN-11. RF-SLA-003.'
}

Table envios_email {
  id uuid [pk, default: `gen_random_uuid()`]
  notificacion_id uuid [not null]
  intentos int [not null, default: 0, note: 'Reintentos de envío (R-12)']
  ultimo_error text [note: 'Último error del proveedor de email']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Log de envíos de email con reintentos (R-12). Eventos: invitación enviada/aceptada/rechazada, recordatorio 72 h, invitación vencida, nueva propuesta/cambio, acuerdo firmado.'
}

// ============================================================
// TABLAS — INVERSORES
// ============================================================

Table inversores {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [not null]
  email text [not null]
  capital_disponible text [note: 'Rango o monto de capital disponible']
  experiencia text [note: 'Experiencia del inversor']
  fecha timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Landing de captación. RF-INV. No es un rol con cuenta.'
}

// ============================================================
// TABLAS — AUDITORÍA
// ============================================================

Table auditoria {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid
  accion text [not null, note: 'Acción realizada (ej. "crear_caso", "firmar_acuerdo")']
  entidad text [not null, note: 'Entidad afectada (ej. "casos", "acuerdos")']
  entidad_id uuid [note: 'ID del registro afectado']
  detalle jsonb [note: 'Detalles adicionales (before/after, metadata)']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Log de auditoría inmutable. RNF-10: trazabilidad de acciones relevantes.'
}

// ============================================================
// TABLAS — CONFIGURACIÓN
// ============================================================

Table configuracion {
  id uuid [pk, default: `gen_random_uuid()`]
  clave text [unique, not null, note: 'Clave del setting (ej. "ia_modelo")']
  valor jsonb [not null, note: 'Valor del setting']
  descripcion text [note: 'Descripción del setting']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Configuración del sistema (key-value). RF-IA-005: modelo IA conmutable. RF-CFG.'
}

// ============================================================
// TABLAS — MÓDULO LEGAL (TyC)
// ============================================================
// Contrato congelado: docs/tyc-contrato-frontend.md (§2).
// Decisiones: docs/decisiones-db/2026-08-14-tyc-contrato-con-db.md (1-7).

Table legal_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  tipo text [not null, note: "'terms' | 'privacy'"]
  version text [not null, note: 'Ej: v1.0, v1.1']
  contenido text [not null, note: 'Texto completo; formato "## X. TÍTULO" = sección, resto = párrafo']
  valid_from timestamptz [not null, default: `now()`, note: 'Fecha de "última actualización" visible en FE']
  valid_to timestamptz [note: 'NULL = versión vigente; una sola vigente por tipo (partial unique)']
  is_substantial bool [not null, default: false, note: 'Dispara la re-aceptación bloqueante']
  resumen_cambios text [note: 'El "qué cambió" en lenguaje llano que muestra el gate']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Documentos legales versionados (texto en la base, no en el front). Lectura pública (anon/authenticated) de la versión vigente. Partial unique (tipo) WHERE valid_to IS NULL.'
}

Table user_agreements {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'FK auth.users(id) ON DELETE RESTRICT (retención 5 años, guarda anti depuración R-06)']
  document_type text [not null, note: "'terms' | 'privacy' | 'marketing'"]
  document_version text [not null, note: 'Versión aceptada (match exacto con legal_documents.version)']
  accepted_at timestamptz [not null, default: `now()`]
  ip inet [not null, note: 'Resuelta por el servidor (x-forwarded-for) — no falsificable por el cliente']
  user_agent text [not null, note: 'Header User-Agent — resuelto por el servidor']
  accepted bool [not null, note: 'marketing con false también se guarda']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Registro legal append-only: UPDATE/DELETE rechazados por trigger para TODOS los roles (incluido service_role). Un registro por aceptación y por tipo. INSERT solo para service_role/postgres.'
}

Table solicitudes_arrepentimiento {
  id uuid [pk, default: `gen_random_uuid()`]
  codigo text [unique, note: 'ARR-0001… generado por trigger (secuencia propia)']
  nombre text [not null]
  email text [not null]
  detalle text [not null]
  received_at timestamptz [not null, default: `now()`, note: 'Es el received_at de la respuesta del endpoint público']
  estado estado_arrepentimiento [not null, default: 'recibida']
  usuario_id uuid [note: 'FK auth.users(id) ON DELETE SET NULL — la traza se conserva aunque el usuario se borre']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Traza del POST público /legal/arrepentimiento (Res. 424/2020). Sin policies RLS; escritura solo vía roles de servidor (service_role/postgres).'
}

Table avisos_version_legal {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid [not null, note: 'FK auth.users(id) ON DELETE RESTRICT — traza del cumplimiento del preaviso, se conserva']
  tipo text [not null, note: "'terms' | 'privacy'"]
  version text [not null, note: 'Versión publicada que se avisó']
  notificado_at timestamptz [not null, default: `now()`, note: 'Cuándo se reclamó el aviso']
  enviado_at timestamptz [note: 'NULL = reclamado pero el mail no salió; el barrido lo reintenta']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Traza e idempotencia del aviso de cambio de versión (#15). UNIQUE (usuario_id, tipo, version) es lo que impide el email duplicado: el barrido inserta con ON CONFLICT DO NOTHING, nunca con un existence check previo. Sin policies RLS; solo roles de servidor.'
}

Table solicitudes_contacto {
  id uuid [pk, default: `gen_random_uuid()`]
  codigo text [unique, note: 'CON-0001… generado por trigger (secuencia propia)']
  nombre text [not null]
  email text [not null]
  mensaje text [not null]
  received_at timestamptz [not null, default: `now()`, note: 'Fecha de ingreso: sostiene el plazo de respuesta declarado']
  estado estado_arrepentimiento [not null, default: 'recibida']
  usuario_id uuid [note: 'FK auth.users(id) ON DELETE SET NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Canal de contacto público (#23). Espeja solicitudes_arrepentimiento y reutiliza su enum de estado. Sin policies RLS; escritura solo vía roles de servidor.'
}

// ============================================================
// RELACIONES
// ============================================================

// Identidad
Ref: usuarios.estudio_id > estudios.id
Ref: estudios.plan_id > planes.id
Ref: carpetas.estudio_id > estudios.id

// Monetización
Ref: suscripciones.usuario_id > usuarios.id
Ref: suscripciones.estudio_id > estudios.id
Ref: suscripciones.plan_id > planes.id
Ref: pagos.suscripcion_id > suscripciones.id
Ref: facturas.pago_id > pagos.id

// Casos
Ref: casos.creador_id > usuarios.id
Ref: casos.estudio_id > estudios.id
Ref: casos.carpeta_id > carpetas.id
Ref: caso_partes.caso_id > casos.id
Ref: caso_partes.usuario_id > usuarios.id
Ref: invitaciones.caso_id > casos.id

// Items
Ref: items.caso_id > casos.id
Ref: items.parte_id > usuarios.id

// Rondas y propuestas
Ref: rondas.caso_id > casos.id
Ref: propuestas.caso_id > casos.id
Ref: propuestas.ronda_id > rondas.id
Ref: respuestas_propuesta.propuesta_id > propuestas.id
Ref: respuestas_propuesta.parte_id > usuarios.id

// Mediación
Ref: mediaciones.caso_id > casos.id
Ref: mediaciones.mediador_id > usuarios.id

// Acuerdos
Ref: acuerdos.caso_id > casos.id
Ref: firmas.acuerdo_id > acuerdos.id
Ref: firmas.usuario_id > usuarios.id
Ref: tareas.acuerdo_id > acuerdos.id
Ref: tareas.caso_id > casos.id
Ref: incumplimientos.acuerdo_id > acuerdos.id
Ref: incumplimientos.reportante_id > usuarios.id

// Notificaciones
Ref: notificaciones.usuario_id > usuarios.id
Ref: notificaciones.caso_id > casos.id
Ref: envios_email.notificacion_id > notificaciones.id

// Auditoría
Ref: auditoria.usuario_id > usuarios.id

// Módulo legal (TyC) — FKs directas a auth.users (retención legal)
Ref: user_agreements.user_id > auth.users.id [delete: restrict]
Ref: solicitudes_arrepentimiento.usuario_id > auth.users.id [delete: set null]